{
  "name": "peegeeq-cache-management-ui",
  "version": "0.1.0-SNAPSHOT",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "22.22.2",
    "npm": "10.9.4"
  },
  "scripts": {
    "build": "npm run type-check && vite build",
    "dev": "vite --host 127.0.0.1 --port 3001",
    "generate:openapi": "openapi-typescript ../peegee-cache-rest/src/main/openapi/peegeeq-cache-management-v1.yaml -o target/generated-sources/openapi/management.ts",
    "lint": "eslint . --max-warnings 0",
    "quality": "npm run type-check && npm run lint",
    "test:run": "vitest run",
    "type-check": "tsc --noEmit",
    "verify": "npm run generate:openapi && npm run quality && npm run test:run && npm run build"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.10.1",
    "antd": "5.12.8",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-redux": "9.2.0",
    "react-router-dom": "7.18.2",
    "recharts": "3.1.2",
    "zod": "4.2.1",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.10.2",
    "@types/react": "18.2.43",
    "@types/react-dom": "18.2.17",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitejs/plugin-react": "4.3.4",
    "axe-core": "4.12.1",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.9.1",
    "typescript": "5.7.2",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "yaml": "2.9.0"
  }
}
