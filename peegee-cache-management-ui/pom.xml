<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.mars</groupId>
        <artifactId>peegee-cache-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>peegee-cache-management-ui</artifactId>
    <name>peegee-cache-management-ui</name>
    <packaging>jar</packaging>

    <description>Build boundary for the separately tracked PeeGeeQ Cache management UI.</description>

    <properties>
        <node.version>v22.22.2</node.version>
        <npm.version>10.9.4</npm.version>
        <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-maven-plugin.version}</version>
                <configuration>
                    <nodeVersion>${node.version}</nodeVersion>
                    <npmVersion>${npm.version}</npmVersion>
                    <workingDirectory>${project.basedir}</workingDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>npm-ci</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>ci</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-openapi-types</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run generate:openapi</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>frontend-quality</id>
                        <phase>test</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run quality</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>frontend-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run test:run</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>frontend-build</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>verify-production-ui-artifact</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <available file="${project.build.outputDirectory}/ui/index.html"
                                           property="peegeeq.ui.index.present"/>
                                <fail unless="peegeeq.ui.index.present"
                                      message="Production UI artifact must contain ui/index.html"/>

                                <fileset id="peegeeq.ui.assets"
                                         dir="${project.build.outputDirectory}/ui/assets"
                                         includes="*"/>
                                <resourcecount refid="peegeeq.ui.assets"
                                               property="peegeeq.ui.asset.count"/>
                                <condition property="peegeeq.ui.assets.present">
                                    <not>
                                        <equals arg1="${peegeeq.ui.asset.count}" arg2="0"/>
                                    </not>
                                </condition>
                                <fail unless="peegeeq.ui.assets.present"
                                      message="Production UI artifact must contain fingerprinted assets"/>

                                <fileset id="peegeeq.ui.source.maps"
                                         dir="${project.build.outputDirectory}/ui"
                                         includes="**/*.map"/>
                                <resourcecount refid="peegeeq.ui.source.maps"
                                               property="peegeeq.ui.source.map.count"/>
                                <condition property="peegeeq.ui.source.maps.absent">
                                    <equals arg1="${peegeeq.ui.source.map.count}" arg2="0"/>
                                </condition>
                                <fail unless="peegeeq.ui.source.maps.absent"
                                      message="Production UI artifact must not contain source maps"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
