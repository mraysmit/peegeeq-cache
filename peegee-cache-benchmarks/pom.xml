<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.mars</groupId>
        <artifactId>peegee-cache-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>peegee-cache-benchmarks</artifactId>
    <name>peegee-cache-benchmarks</name>
    <packaging>jar</packaging>

    <properties>
        <peegeeq.benchmark.concurrency>8</peegeeq.benchmark.concurrency>
        <peegeeq.benchmark.poolSize>12</peegeeq.benchmark.poolSize>
        <peegeeq.benchmark.warmupSeconds>5</peegeeq.benchmark.warmupSeconds>
        <peegeeq.benchmark.durationSeconds>30</peegeeq.benchmark.durationSeconds>
        <peegeeq.benchmark.minimumThroughput>50</peegeeq.benchmark.minimumThroughput>
        <peegeeq.benchmark.maximumP99Millis>1000</peegeeq.benchmark.maximumP99Millis>
        <peegeeq.benchmark.maximumFailoverRecoveryMillis>10000</peegeeq.benchmark.maximumFailoverRecoveryMillis>
        <peegeeq.benchmark.maximumExpiryLagMillis>1000</peegeeq.benchmark.maximumExpiryLagMillis>
        <peegeeq.benchmark.maximumTelemetryOverheadPercent>100</peegeeq.benchmark.maximumTelemetryOverheadPercent>
        <peegeeq.benchmark.mainClass>dev.mars.peegeeq.cache.benchmark.CacheBenchmarkMain</peegeeq.benchmark.mainClass>
        <peegeeq.benchmark.capture.runs>3</peegeeq.benchmark.capture.runs>
        <peegeeq.benchmark.capture.outputRoot>benchmark-results</peegeeq.benchmark.capture.outputRoot>
        <peegeeq.benchmark.capture.topology>Local benchmark JVM and Testcontainers PostgreSQL on the same Docker engine</peegeeq.benchmark.capture.topology>
        <peegeeq.benchmark.capture.requireCleanGit>false</peegeeq.benchmark.capture.requireCleanGit>
        <peegeeq.benchmark.capture.stopOnFailure>false</peegeeq.benchmark.capture.stopOnFailure>
        <peegeeq.test.postgres.image>postgres:18.3-alpine</peegeeq.test.postgres.image>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.mars</groupId>
            <artifactId>peegee-cache-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.mars</groupId>
            <artifactId>peegee-cache-observability</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.mars</groupId>
            <artifactId>peegee-cache-test-support</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <executable>java</executable>
                    <arguments>
                        <argument>-Dvertx.logger-delegate-factory-class-name=io.vertx.core.logging.SLF4JLogDelegateFactory</argument>
                        <argument>-Dorg.slf4j.simpleLogger.defaultLogLevel=info</argument>
                        <argument>-Dorg.slf4j.simpleLogger.showDateTime=true</argument>
                        <argument>-Dorg.slf4j.simpleLogger.dateTimeFormat=yyyy-MM-dd'T'HH:mm:ss.SSSXXX</argument>
                        <argument>-Dpeegeeq.benchmark.concurrency=${peegeeq.benchmark.concurrency}</argument>
                        <argument>-Dpeegeeq.benchmark.poolSize=${peegeeq.benchmark.poolSize}</argument>
                        <argument>-Dpeegeeq.benchmark.warmupSeconds=${peegeeq.benchmark.warmupSeconds}</argument>
                        <argument>-Dpeegeeq.benchmark.durationSeconds=${peegeeq.benchmark.durationSeconds}</argument>
                        <argument>-Dpeegeeq.benchmark.minimumThroughput=${peegeeq.benchmark.minimumThroughput}</argument>
                        <argument>-Dpeegeeq.benchmark.maximumP99Millis=${peegeeq.benchmark.maximumP99Millis}</argument>
                        <argument>-Dpeegeeq.benchmark.maximumFailoverRecoveryMillis=${peegeeq.benchmark.maximumFailoverRecoveryMillis}</argument>
                        <argument>-Dpeegeeq.benchmark.maximumExpiryLagMillis=${peegeeq.benchmark.maximumExpiryLagMillis}</argument>
                        <argument>-Dpeegeeq.benchmark.maximumTelemetryOverheadPercent=${peegeeq.benchmark.maximumTelemetryOverheadPercent}</argument>
                        <argument>-Dpeegeeq.benchmark.capture.runs=${peegeeq.benchmark.capture.runs}</argument>
                        <argument>-Dpeegeeq.benchmark.capture.outputRoot=${peegeeq.benchmark.capture.outputRoot}</argument>
                        <argument>-Dpeegeeq.benchmark.capture.repositoryRoot=${maven.multiModuleProjectDirectory}</argument>
                        <argument>-Dpeegeeq.benchmark.capture.topology=${peegeeq.benchmark.capture.topology}</argument>
                        <argument>-Dpeegeeq.benchmark.capture.requireCleanGit=${peegeeq.benchmark.capture.requireCleanGit}</argument>
                        <argument>-Dpeegeeq.benchmark.capture.stopOnFailure=${peegeeq.benchmark.capture.stopOnFailure}</argument>
                        <argument>-Dpeegeeq.test.postgres.image=${peegeeq.test.postgres.image}</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>${peegeeq.benchmark.mainClass}</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>benchmark</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>run-cache-benchmark</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>benchmark-capture</id>
            <properties>
                <peegeeq.benchmark.mainClass>dev.mars.peegeeq.cache.benchmark.BenchmarkCaptureMain</peegeeq.benchmark.mainClass>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>capture-cache-benchmarks</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
