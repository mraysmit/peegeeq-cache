<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.mars</groupId>
        <artifactId>peegee-cache-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>peegee-cache-benchmarks</artifactId>
    <name>peegee-cache-benchmarks</name>
    <packaging>jar</packaging>

    <properties>
        <peegeeq.benchmark.concurrency>8</peegeeq.benchmark.concurrency>
        <peegeeq.benchmark.durationSeconds>30</peegeeq.benchmark.durationSeconds>
        <peegeeq.benchmark.minimumThroughput>50</peegeeq.benchmark.minimumThroughput>
        <peegeeq.benchmark.maximumP99Millis>1000</peegeeq.benchmark.maximumP99Millis>
        <peegeeq.benchmark.maximumFailoverRecoveryMillis>10000</peegeeq.benchmark.maximumFailoverRecoveryMillis>
        <peegeeq.benchmark.maximumExpiryLagMillis>1000</peegeeq.benchmark.maximumExpiryLagMillis>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.mars</groupId>
            <artifactId>peegee-cache-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.mars</groupId>
            <artifactId>peegee-cache-observability</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.mars</groupId>
            <artifactId>peegee-cache-test-support</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <executable>java</executable>
                    <arguments>
                        <argument>-Dpeegeeq.benchmark.concurrency=${peegeeq.benchmark.concurrency}</argument>
                        <argument>-Dpeegeeq.benchmark.durationSeconds=${peegeeq.benchmark.durationSeconds}</argument>
                        <argument>-Dpeegeeq.benchmark.minimumThroughput=${peegeeq.benchmark.minimumThroughput}</argument>
                        <argument>-Dpeegeeq.benchmark.maximumP99Millis=${peegeeq.benchmark.maximumP99Millis}</argument>
                        <argument>-Dpeegeeq.benchmark.maximumFailoverRecoveryMillis=${peegeeq.benchmark.maximumFailoverRecoveryMillis}</argument>
                        <argument>-Dpeegeeq.benchmark.maximumExpiryLagMillis=${peegeeq.benchmark.maximumExpiryLagMillis}</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>dev.mars.peegeeq.cache.benchmark.CacheBenchmarkMain</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>benchmark</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>run-cache-benchmark</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
